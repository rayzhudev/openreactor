{
  "name": "openreactor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bunx @tailwindcss/cli -i src/input.css -o public/styles.css --watch & wrangler pages dev public",
    "css:build": "bunx @tailwindcss/cli -i src/input.css -o public/styles.css --minify",
    "deploy": "bun run css:build && wrangler pages deploy public --project-name openreactor",
    "check": "bun run css:build && tsc --noEmit",
    "agent-browser:install": "agent-browser install",
    "test:ui": "bunx playwright test",
    "smoke:pages": "bun run ./scripts/pages-smoke-test.ts",
    "reactor": "bun run reactor/index.ts",
    "reactor:once": "bun run reactor/index.ts --once",
    "reactor:dry-run": "bun run reactor/index.ts --once --dry-run",
    "reactor:tool": "bun run reactor/tool.ts",
    "openreactor:self-test": "bun run reactor/self-test.ts",
    "openreactor-status": "bun run openreactor-status/index.ts",
    "openreactor-status:tunnel": "bash scripts/openreactor-status-tunnel.sh",
    "watchdog": "bash scripts/watchdog-service.sh",
    "watchdog:once": "bash scripts/watchdog-service.sh --once"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^24.5.2",
    "agent-browser": "0.17.1",
    "typescript": "^5.9.2",
    "wrangler": "^4.64.0"
  },
  "dependencies": {
    "@tailwindcss/cli": "^4.2.1",
    "tailwindcss": "^4.2.1"
  }
}
