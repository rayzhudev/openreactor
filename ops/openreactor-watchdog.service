[Unit]
Description=OpenReactor watchdog
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/ray/projects/openreactor
ExecStart=/usr/bin/bash /home/ray/projects/openreactor/scripts/watchdog-service.sh
Restart=always
RestartSec=10
TimeoutStopSec=20
Environment=HOME=/home/ray
Environment=USER=ray

[Install]
WantedBy=default.target
