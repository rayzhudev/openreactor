# Copy this file to:
#   /home/ray/.config/openreactor/reactor.env
#
# Use a single line for GITHUB_APP_PRIVATE_KEY with literal \n escapes.

# Optional when the OpenReactor engine is managing a different local clone.
# Leave both unset when managing this repo directly.
# OPENREACTOR_ENGINE_ROOT=/home/ray/projects/openreactor
# OPENREACTOR_MANAGED_REPO_ROOT=/home/ray/projects/some-other-repo

# Optional repo-scoped execution policy:
#   /home/ray/projects/some-other-repo/.openreactor/repo/workspace-policy.json
# or /home/ray/projects/some-other-repo/workspace-policy.json
# Use that file for provision/teardown hooks or repo-specific env injection.

GITHUB_OWNER=rayzhudev
GITHUB_REPO=openreactor
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY=

# Optional fallback if app credentials are not available.
# GITHUB_TOKEN=

# Optional reactor tuning.
# OPENREACTOR_POLL_INTERVAL_MS=60000
# OPENREACTOR_MAX_ITERATION_RUNTIME_MS=1200000
# OPENREACTOR_MAX_CONCURRENT_ISSUES=3
# OPENREACTOR_MAX_ITERATIONS_PER_ISSUE=8
# OPENREACTOR_MAX_START_FAILURES_PER_ISSUE=3
# OPENREACTOR_PAUSED_LABEL=or:paused
# OPENREACTOR_TRIAGE_MODEL=gpt-5.5
# OPENREACTOR_TRIAGE_REASONING_EFFORT=low
# Optional. Leave unset unless you have a known-good service tier for this Codex build/account.
# OPENREACTOR_TRIAGE_SERVICE_TIER=
# OPENREACTOR_PLANNER_MODEL=gpt-5.5
# OPENREACTOR_PLANNER_REASONING_EFFORT=high
# Optional. Leave unset unless you have a known-good service tier for this Codex build/account.
# OPENREACTOR_PLANNER_SERVICE_TIER=
# OPENREACTOR_AGENT_MODEL=gpt-5.5
# OPENREACTOR_AGENT_REASONING_EFFORT=medium
# Optional. Leave unset unless you have a known-good service tier for this Codex build/account.
# OPENREACTOR_AGENT_SERVICE_TIER=
# OPENREACTOR_CODEX_UI_MODEL=gpt-5.5
# OPENREACTOR_CODEX_UI_REASONING_EFFORT=high
# Optional. Leave unset unless you have a known-good service tier for this Codex build/account.
# OPENREACTOR_CODEX_UI_SERVICE_TIER=
# OPENREACTOR_UI_DESIGN_MODEL=gpt-5.5
# OPENREACTOR_UI_DESIGN_REASONING_EFFORT=xhigh
# Optional. Leave unset unless you have a known-good service tier for this Codex build/account.
# OPENREACTOR_UI_DESIGN_SERVICE_TIER=
# OPENREACTOR_CLAUDE_MODEL=sonnet
# OPENREACTOR_CLAUDE_EFFORT=medium
# OPENREACTOR_CLAUDE_BIN=/home/ray/.local/bin/claude
# OPENREACTOR_BOT_MENTION_ALIASES=@openreactor,@openreactor[bot],@open-reactor-bot,@open-reactor-bot[bot]

# Optional watchdog tuning.
# OPENREACTOR_WATCHDOG_POLL_INTERVAL_MS=120000
# OPENREACTOR_WATCHDOG_DEADLOCK_ESCALATION_MS=1200000
# OPENREACTOR_WATCHDOG_DEADLOCK_AUTO_HEAL_COOLDOWN_MS=300000
# OPENREACTOR_WATCHDOG_RUNNING_CLAIM_GRACE_MS=300000
# OPENREACTOR_WATCHDOG_RUNNING_STALL_MS=900000
# OPENREACTOR_WATCHDOG_MAX_RUNNING_ITERATIONS_BEFORE_RESET=8
# OPENREACTOR_WATCHDOG_PAUSED_RETRY_MS=1200000
# OPENREACTOR_WATCHDOG_PAUSED_ESCALATION_MS=2700000
# OPENREACTOR_WATCHDOG_SERVICE_COOLDOWN_MS=900000
# OPENREACTOR_WATCHDOG_MAX_AUTO_HEAL_ATTEMPTS_PER_ISSUE=2
# OPENREACTOR_REACTOR_SERVICE_NAME=openreactor-reactor.service
# OPENREACTOR_WATCHDOG_SERVICE_NAME=openreactor-watchdog.service

# Optional local status service bridge.
# OPENREACTOR_STATUS_BIND_HOST=127.0.0.1
# OPENREACTOR_STATUS_PORT=8789
# OPENREACTOR_STATUS_TOKEN=
# OPENREACTOR_STATUS_PUBLIC_HOSTNAME=status-openreactor.example.com
# OPENREACTOR_STATUS_TUNNEL_ID=
# OPENREACTOR_STATUS_TUNNEL_CREDENTIALS_FILE=/home/ray/.cloudflared/<tunnel-id>.json
