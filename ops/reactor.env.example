# Copy this file to:
#   /home/ray/.config/openreactor/reactor.env
#
# Use a single line for GITHUB_APP_PRIVATE_KEY with literal \n escapes.

GITHUB_OWNER=rayzhudev
GITHUB_REPO=openreactor
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY=

# Optional fallback if app credentials are not available.
# GITHUB_TOKEN=

# Optional reactor tuning.
# OPENREACTOR_POLL_INTERVAL_MS=60000
# OPENREACTOR_MAX_ITERATION_RUNTIME_MS=1200000
# OPENREACTOR_MAX_CONCURRENT_ISSUES=2
# OPENREACTOR_MAX_ITERATIONS_PER_ISSUE=8
# OPENREACTOR_TRIAGE_MODEL=gpt-5-mini
# OPENREACTOR_TRIAGE_REASONING_EFFORT=minimal
# OPENREACTOR_TRIAGE_SERVICE_TIER=default
# OPENREACTOR_AGENT_MODEL=gpt-5.4
# OPENREACTOR_AGENT_REASONING_EFFORT=medium
# OPENREACTOR_AGENT_SERVICE_TIER=default
