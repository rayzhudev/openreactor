{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "issueNumber": {
      "type": "integer",
      "minimum": 1
    },
    "outcome": {
      "type": "string",
      "enum": ["accepted", "rejected", "retry", "decomposed"]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "considerations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "branchName": {
      "type": ["string", "null"]
    },
    "prUrl": {
      "type": ["string", "null"]
    },
    "issueComment": {
      "type": ["string", "null"]
    },
    "nextStep": {
      "type": ["string", "null"]
    },
    "humanHandoff": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "required": {
          "type": "boolean"
        },
        "instructions": {
          "type": "string"
        }
      },
      "required": ["required", "instructions"]
    },
    "decomposition": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "overview": {
          "type": "string"
        },
        "childIssues": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "title": {
                "type": "string",
                "minLength": 8
              },
              "body": {
                "type": "string",
                "minLength": 20
              },
              "dependsOn": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "required": ["title", "body", "dependsOn"]
          }
        }
      },
      "required": ["overview", "childIssues"]
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "command": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": ["passed", "failed", "not-run"]
          }
        },
        "required": ["command", "status"]
      }
    }
  },
  "required": [
    "issueNumber",
    "outcome",
    "summary",
    "considerations",
    "branchName",
    "prUrl",
    "issueComment",
    "nextStep",
    "humanHandoff",
    "decomposition",
    "tests"
  ]
}
