{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "issueNumber": {
      "type": "integer",
      "minimum": 1
    },
    "outcome": {
      "type": "string",
      "enum": ["reject", "escalate"]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "issueComment": {
      "type": ["string", "null"]
    }
  },
  "required": ["issueNumber", "outcome", "summary", "issueComment"]
}
