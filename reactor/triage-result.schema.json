{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "issueNumber": {
      "type": "integer",
      "minimum": 1
    },
    "outcome": {
      "type": "string",
      "enum": ["reject", "dispatch"]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "issueComment": {
      "type": ["string", "null"]
    },
    "toolName": {
      "type": ["string", "null"],
      "enum": [null, "spawn_codex_issue_agent", "spawn_claude_ui_agent"]
    },
    "toolReason": {
      "type": ["string", "null"]
    }
  },
  "required": ["issueNumber", "outcome", "summary", "issueComment", "toolName", "toolReason"]
}
